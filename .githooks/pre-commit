#!/usr/bin/env bash
# Pre-commit hook: block large files and binary trash.
# Install: cp .githooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

set -euo pipefail

MAX_BYTES=$((5 * 1024 * 1024))  # 5MB hard limit

# Block by extension
BLOCKED_EXTS="npz npy zip tar gz tgz rar 7z png jpg jpeg gif svg pdf bin html pkl pickle h5 hdf5"

# Check staged files
fail=0
while IFS= read -r -d '' file; do
    size=$(git cat-file -s ":$file" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
        echo "BLOCKED: $file ($(numfmt --to=iec $size) > 5MB limit)"
        fail=1
    fi
    ext="${file##*.}"
    ext_lower=$(echo "$ext" | tr '[:upper:]' '[:lower:]')
    for blocked in $BLOCKED_EXTS; do
        if [ "$ext_lower" = "$blocked" ]; then
            echo "BLOCKED: $file (binary extension .$blocked not allowed)"
            fail=1
            break
        fi
    done
done < <(git diff --cached --name-only -z --diff-filter=ACM)

if [ "$fail" -eq 1 ]; then
    echo ""
    echo "Commit rejected. Remove these files from staging or add to .gitignore."
    echo "To force: git commit --no-verify"
    exit 1
fi
